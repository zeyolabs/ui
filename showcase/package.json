{
	"name": "showcase",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": "^11.0.0"
	},
	"scripts": {
		"dev": "pnpm cf-typegen && vite dev",
		"build": "vite build",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "eslint . --cache --cache-location .cache/.eslintcache --cache-strategy content",
		"check": "pnpm lint && pnpm cf-typegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings css_unused_selector:error",
		"ci": "pnpm check",
		"cf-typegen": "shx rm -rf .svelte-kit/cloudflare && wrangler types ./worker-configuration.d.ts",
		"cf-deploy": "pnpm cf-typegen && pnpm build && pnpm wrangler deploy"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/load-config": "0.2.2",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "22.19.19",
		"eslint": "9.39.4",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"shx": "0.4.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.2",
		"wrangler": "4.147.0"
	},
	"dependencies": {
		"@lucide/svelte": "1.52.0",
		"@zeyolabs/kit": "2026.11.7",
		"@zeyolabs/ui": "workspace:*",
		"svelte-sonner": "1.2.1",
		"zod": "4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
