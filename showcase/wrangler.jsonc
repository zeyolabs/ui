{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ui",
	"compatibility_date": "2026-11-13",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "ui.zeyo.dev", "custom_domain": true }],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
}
