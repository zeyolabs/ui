{
	"name": "@zeyolabs/ui",
	"version": "2026.1106.0",
	"description": "Shared Svelte 5 components, form fields and design tokens for SvelteKit 3 apps.",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zeyolabs/ui.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": "^11.0.0"
	},
	"scripts": {
		"lint": "eslint . --cache --cache-location .cache/.eslintcache --cache-strategy content",
		"fmt": "prettier --write --cache --cache-location=.cache/.prettier-cache --cache-strategy content .",
		"fmt:check": "prettier --check --cache --cache-location=.cache/.prettier-cache --cache-strategy content .",
		"check": "pnpm fmt:check && pnpm lint && pnpm --filter showcase check",
		"ci": "pnpm check && pnpm showcase:build",
		"showcase:dev": "pnpm --filter showcase dev",
		"showcase:build": "pnpm --filter showcase build",
		"showcase:deploy": "pnpm --filter showcase cf-deploy"
	},
	"files": [
		"account",
		"back-button",
		"badge",
		"bar",
		"base.css",
		"boundary",
		"card",
		"copy",
		"dialog",
		"distribution-bar",
		"drawer",
		"empty-state",
		"error",
		"eyebrow",
		"faq",
		"filter",
		"form",
		"gallery",
		"grouped-grid",
