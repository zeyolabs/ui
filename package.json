		"svelte-sonner": "1.2.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "9.39.4",
		"@zeyolabs/kit": "2026.11.13",
		"@sveltejs/kit": "3.1.1",
		"@types/flickity": "2.2.12",
		"eslint": "9.39.4",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-drizzle": "0.2.3",
		"eslint-plugin-perfectionist": "5.9.1",
